# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs — get free ones from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
UNICHAIN_SEPOLIA_RPC_URL=https://unichain-sepolia.g.alchemy.com/v2/YOUR_KEY

# One Etherscan API key covers Sepolia, Base Sepolia, and Unichain Sepolia
# via the Etherscan V2 API (https://api.etherscan.io/v2/api?chainid=CHAIN_ID)
# Get yours free at https://etherscan.io/apidashboard
ETHERSCAN_API_KEY=your_etherscan_key_here

# ── Set ONE of these per deployment ────────────────────────────────────────────

# Sepolia (11155111)
POOL_MANAGER=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
POOL_MODIFY_LIQUIDITY_TEST=0x0c478023803a644c94c4ce1c1e7b9a087e411b0a
POOL_SWAP_TEST=0x9b6b46e2c869aa39918db7f52f5557fe577b6eee

